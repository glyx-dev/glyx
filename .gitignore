target/

# JS dependencies — regenerated by `bun install`
node_modules/
**/node_modules/
**/*/node_modules/

# OS and editor noise
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

*.db
*.db-shm
*.db-wal
# Example-app build output. Bundles are loaded from disk at RUNTIME
# (`AppConfig::from_config`), never `include_str!`-ed, so `cargo build`
# works on a fresh checkout without them; `glyx dev` / `glyx build`
# regenerate them. Covered here at the root so a new example is ignored
# even before it gets its own .gitignore.
examples/*/js/dist/
examples/*/dist/
examples/*/target/

# Written by the glyx-media release workflow
glyx-media-c/glyx_media_version.h
