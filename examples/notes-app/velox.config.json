{
  "window": {
    "title":       "Notes",
    "width":       1100,
    "height":      780,
    "startupMode": "windowed"
  },
  "capabilities": {
    "fs":             { "read": ["**"], "write": ["**"] },
    "network":        { "allow": ["*"] },
    "db":             true,
    "dialog":         true,
    "clipboard":      true,
    "notification":   true,
    "mdns":           true,
    "battery":        true,
    "system":         true,
    "power":          true,
    "storage":        true,
    "gamepads":       true,
    "globalShortcuts": true,
    "credentials":    true,
    "audio":          true,
    "deeplink": { "scheme": "notes", "singleInstance": true }
  },
  "dev": {
    "entry": "js/app.jsx",
    "output": "js/app.js",
    "watch": ["js"]
  }
}
