{
  "window": {
    "title":       "Notes",
    "width":       1100,
    "height":      780,
    "startupMode": "windowed"
  },
  "capabilities": {
    "fs":           { "read": ["**"], "write": ["**"] },
    "network":      { "allow": ["*"] },
    "db":           true,
    "dialog":       true,
    "clipboard":    true,
    "notification": true,
    "mdns":         true
  },
  "dev": {
    "entry": "js/app.jsx",
    "output": "js/app.js",
    "watch": ["js"]
  }
}
