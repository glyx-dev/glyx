{
  "name": "@glyx-dev/testing",
  "version": "0.2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "src",
    "types",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.js",
    "./setup": "./setup.js"
  },
  "scripts": {
    "test": "bun test --preload ../testing/setup.js"
  },
  "description": "Test utilities for Glyx apps \u2014 compatible with Bun's test runner",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-reconciler": ">=0.29"
  }
}
