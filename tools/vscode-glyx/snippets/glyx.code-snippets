      "  items={[",
      "    { key: '${1:tab1}', label: '${3:Tab 1}', content: <${4:Tab1Content} /> },",
      "    { key: '${5:tab2}', label: '${6:Tab 2}', content: <${7:Tab2Content} /> },",
