  // ── Canvas ────────────────────────────────────────────────────────────────
  "Canvas 2D": {
    "prefix": "gcanvas",
    "body": [
      "const canvasRef = React.useRef(null);",
      "",
      "React.useEffect(() => {",
      "  const ctx = canvasRef.current;",
      "  if (!ctx) return;",
      "  const id = setInterval(() => {",
      "    ctx.clear();",
      "    $0",
      "    ctx.flush();",
      "  }, ${1:16});",
      "  return () => clearInterval(id);",
      "}, []);",
      "",
      "<Canvas ref={canvasRef} width={${2:400}} height={${3:300}} />"
    ],
    "description": "Glyx Canvas 2D with animation loop"
  },
  "Canvas 3D": {
    "prefix": "gcanvas3d",
    "body": [
