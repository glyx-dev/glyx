{
  "name": "vscode-velox",
  "displayName": "Velox",
  "description": "Official VS Code extension for Velox — run, build, and develop Velox desktop apps from the editor.",
  "version": "0.1.0",
  "publisher": "velox",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/velox-dev/velox"
  },
  "categories": ["Other"],
  "keywords": ["velox", "desktop", "rust", "react", "wgpu"],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "workspaceContains:velox.config.json",
    "workspaceContains:velox.config.ts"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "velox.run",
        "title": "Run Dev Server",
        "category": "Velox",
        "icon": "$(play)"
      },
      {
        "command": "velox.stopDev",
        "title": "Stop Dev Server",
        "category": "Velox",
        "icon": "$(stop-circle)"
      },
      {
        "command": "velox.build",
        "title": "Build",
        "category": "Velox",
        "icon": "$(package)"
      },
      {
        "command": "velox.package",
        "title": "Package for Distribution",
        "category": "Velox",
        "icon": "$(archive)"
      },
      {
        "command": "velox.openConfig",
        "title": "Open velox.config.json",
        "category": "Velox",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "velox.run",
          "when": "view == veloxProject && !velox.devRunning",
          "group": "navigation"
        },
        {
          "command": "velox.stopDev",
          "when": "view == veloxProject && velox.devRunning",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "velox.run",
          "when": "resourceFilename == velox.config.json",
          "group": "velox"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "velox-sidebar",
          "title": "Velox",
          "icon": "assets/velox-activity.svg"
        }
      ]
    },
    "views": {
      "velox-sidebar": [
        {
          "id": "veloxProject",
          "name": "Project",
          "when": "velox.isVeloxProject"
        },
        {
          "id": "veloxNoProject",
          "name": "Velox",
          "when": "!velox.isVeloxProject"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "veloxNoProject",
        "contents": "No Velox project detected in this workspace.\n\nOpen a folder containing **velox.config.json** or create a new project:\n[Create Velox App](command:velox.createProject)"
      }
    ],
    "configuration": {
      "title": "Velox",
      "properties": {
        "velox.cliPath": {
          "type": "string",
          "default": "velox",
          "description": "Path to the velox CLI executable. Uses 'velox' from PATH by default."
        },
        "velox.buildTarget": {
          "type": "string",
          "default": "",
          "enum": ["", "windows", "macos", "linux"],
          "enumDescriptions": [
            "Current platform",
            "Windows (x86_64-pc-windows-msvc)",
            "macOS (aarch64-apple-darwin)",
            "Linux (x86_64-unknown-linux-gnu)"
          ],
          "description": "Default target platform for velox build."
        },
        "velox.autoOpenDevTools": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the CDP inspector URL when running velox dev --inspect."
        }
      }
    },
    "snippets": [
      {
        "language": "javascriptreact",
        "path": "./snippets/velox.code-snippets"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/velox.code-snippets"
      },
      {
        "language": "javascript",
        "path": "./snippets/velox.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/velox.code-snippets"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "velox.config.json",
        "url": "./schemas/velox.config.schema.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "velox",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "description": "The velox command to run",
            "enum": ["dev", "build", "package"]
          },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Additional CLI arguments"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "velox-cargo",
        "owner": "velox",
        "source": "velox build",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "severity": "error",
        "pattern": [
          {
            "regexp": "^(error|warning)(\\[([A-Z]\\d+)\\])?: (.*)$",
            "severity": 1,
            "code": 3,
            "message": 4
          },
          {
            "regexp": "^\\s+-->\\s+([^:]+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "loop": true
          }
        ]
      },
      {
        "name": "velox-js",
        "owner": "velox",
        "source": "velox dev",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s+at .+ \\((.+):(\\d+):(\\d+)\\)$",
          "file": 1,
          "line": 2,
          "column": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[HMR\\] change detected",
          "endsPattern": "\\[HMR\\] (build ok|build failed)"
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "vscode:prepublish": "tsc -p .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
